#!/usr/bin/env bash
# tmux-home test runner.
#
# Everything runs against two THROWAWAY tmux servers and never touches the
# default socket:
#   tmux-home-test        the server tmux-home manages (sessions alpha, beta)
#   tmux-home-test-outer  hosts one 200x50 pane with a client attached to
#                         tmux-home-test, so the real popup binding can be
#                         pressed, typed into (send-keys) and read back
#                         (capture-pane).
#
# Usage: tests/run            (exit status = number of failed checks, capped)

# shellcheck disable=SC2016,SC2329 # bash -c bodies; functions called via check
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN="$ROOT/bin/tmux-home"

unset TMUX TMUX_PANE TMUX_HOME_CLIENT
# closed-window stack in a throwaway dir, never the real state dir
TMUX_HOME_STATE_DIR=$(mktemp -d "${TMPDIR:-/tmp}/tmux-home-test.XXXXXX")
export TMUX_HOME_STATE_DIR XDG_STATE_HOME=$TMUX_HOME_STATE_DIR/xdg
CLOSED=$TMUX_HOME_STATE_DIR/closed
export TMUX_HOME_TMUX="tmux -L tmux-home-test"
export SHELL=/bin/sh # predictable, fast pane shells
export LC_ALL=en_US.UTF-8

T() { tmux -L tmux-home-test -f /dev/null "$@"; }
O() { tmux -L tmux-home-test-outer -f /dev/null "$@"; }
S() { tmux -L tmux-home-test-solo -f /dev/null "$@"; }

cleanup() {
	T kill-server 2>/dev/null
	O kill-server 2>/dev/null
	S kill-server 2>/dev/null
}
trap 'cleanup; rm -rf "$TMUX_HOME_STATE_DIR"' EXIT
cleanup

pass=0 fail=0
ok() { pass=$((pass + 1)); printf 'ok   %s\n' "$1"; }
not_ok() {
	fail=$((fail + 1))
	printf 'FAIL %s\n' "$1"
	[[ -n ${2:-} ]] && printf '%s\n' "$2" | sed 's/^/     | /'
}
check() { # check NAME CMD...
	local name=$1
	shift
	if "$@"; then ok "$name"; else not_ok "$name"; fi
}
eq() { # eq NAME EXPECTED ACTUAL
	if [[ $2 == "$3" ]]; then ok "$1"; else not_ok "$1" "expected: $2"$'\n'"actual:   $3"; fi
}

screen() { O capture-pane -p -t outer; }

# wait_for NAME REGEX [timeout-s]: poll the outer pane until REGEX matches.
wait_for() {
	local name=$1 re=$2 timeout=${3:-5} i
	for ((i = 0; i < timeout * 10; i++)); do
		if screen | grep -Eq -- "$re"; then
			ok "$name"
			return 0
		fi
		sleep 0.1
	done
	not_ok "$name" "$(screen | head -15)"
	return 1
}
wait_gone() { # wait_gone NAME REGEX [timeout-s]
	local name=$1 re=$2 timeout=${3:-5} i
	for ((i = 0; i < timeout * 10; i++)); do
		if ! screen | grep -Eq -- "$re"; then
			ok "$name"
			return 0
		fi
		sleep 0.1
	done
	not_ok "$name" "$(screen | head -15)"
	return 1
}
keys() { O send-keys -t outer "$@"; sleep 0.3; }
typed() { O send-keys -t outer -l "$1"; sleep 0.3; }
esc() { O send-keys -t outer Escape; sleep 0.8; } # inner escape-time is 500ms

wid_of() { T display-message -p -t "$1" '#{window_id}'; }
name_of() { T display-message -p -t "$1" '#{window_name}'; }
auto_of() { T display-message -p -t "$1" '#{?automatic-rename,on,off}'; }
popup_open() { screen | grep -q 'tmux-home'; }

# ------------------------------------------------------------------ fixture
T new-session -d -s alpha -x 200 -y 50 -n editor
T new-window -d -t alpha: -n 'win two'
T new-session -d -s beta -x 200 -y 50 -n logs
T new-window -d -t beta: -n build
# beta:logs gets a sidebar pane that is the ACTIVE pane: it must not be the
# pane the row describes or the preview captures.
T split-window -d -h -t beta:logs
T set-option -p -t beta:logs.1 @pane_role sidebar
T select-pane -t beta:logs.1
T send-keys -t beta:logs.0 'echo MAIN-PANE-MARKER' Enter
T send-keys -t beta:logs.1 'echo SIDEBAR-MARKER' Enter
for w in alpha:editor 'alpha:win two' beta:logs beta:build; do
	T set-option -w -t "$w" automatic-rename off
done
T set-option -g escape-time 500

# ------------------------------------------------------- non-interactive
echo '# list / preview / rename (no client)'

rows=$("$BIN" list)
eq 'list: one row per window' 4 "$(printf '%s\n' "$rows" | wc -l | tr -d ' ')"
eq 'list: no client -> sessions by name, windows by index' \
	"alpha editor|alpha win two|beta logs|beta build" \
	"$(printf '%s\n' "$rows" | cut -f4 | sed 's/\x1b\[[0-9;]*m//g' |
		awk '{ printf "%s%s %s", (NR > 1 ? "|" : ""), $1, ($3 == "win" ? "win two" : $3) }')"
eq 'list: rows carry session and window IDs' \
	"$(T display -p -t alpha:editor '#{session_id} #{window_id}')" \
	"$(printf '%s\n' "$rows" | head -1 | cut -f1,2 | tr '\t' ' ')"
eq 'list: sidebar pane never chosen as the row pane' \
	"$(T display -p -t beta:logs.0 '#{pane_id}')" \
	"$(printf '%s\n' "$rows" | awk -F '\t' -v w="$(wid_of beta:logs)" '$2 == w { print $3 }')"

sleep 0.3
prev=$("$BIN" preview "$(wid_of beta:logs)")
check 'preview: captures the non-sidebar pane' grep -q MAIN-PANE-MARKER <<<"$prev"
check 'preview: does not capture the sidebar pane' bash -c '! grep -q SIDEBAR-MARKER <<<"$1"' _ "$prev"

w=$(wid_of 'alpha:win two')
"$BIN" rename "$w" "-dash (paren)+plus, comma 'q'"
eq 'rename: by ID, name with - ( ) + , quote' "-dash (paren)+plus, comma 'q'" "$(name_of "$w")"
eq 'rename: turns automatic-rename off' off "$(auto_of "$w")"
"$BIN" reset-name "$w"
eq 'reset-name: automatic-rename back on' on "$(auto_of "$w")"
T set-option -w -t "$w" automatic-rename off
T rename-window -t "$w" 'win two'

# busy: what counts as work when deciding whether ^x must ask
T new-window -d -t alpha: -n qb-shell
T new-window -d -t alpha: -n qb-two 'sleep 1000'
T split-window -d -t alpha:qb-two 'tail -f /dev/null'
T new-window -d -t alpha: -n qb-side
T split-window -d -h -t alpha:qb-side 'sleep 1000'
T set-option -p -t alpha:qb-side.1 @pane_role sidebar
sleep 0.3
eq 'busy: idle shell -> nothing' '' "$("$BIN" busy "$(wid_of alpha:qb-shell)")"
eq 'busy: lists each non-shell command' 'sleep, tail' "$("$BIN" busy "$(wid_of alpha:qb-two)")"
eq 'busy: sidebar panes do not count' '' "$("$BIN" busy "$(wid_of alpha:qb-side)")"
for w in qb-shell qb-two qb-side; do T kill-window -t "alpha:$w"; done

# close refuses the last window on the server (it would end the server)
S new-session -d -s solo
solo_w=$(S display-message -p -t solo: '#{window_id}')
TMUX_HOME_TMUX="tmux -L tmux-home-test-solo" "$BIN" close "$solo_w"
eq 'close: last window on the server refused (exit 3)' 3 "$?"
eq 'close: ... and the window survives' "$solo_w" "$(S display-message -p -t solo: '#{window_id}')"
S kill-server

# ------------------------------------------------------- reopen (CLI)
echo '# closed-window stack / reopen'
: >"$CLOSED"
shape() { # index, name, auto-rename, active pane, pane count, geometry + cwd per pane
	T display-message -p -t "$1" '#{window_index}|#{window_name}|#{?automatic-rename,on,off}|#{window_panes}'
	T list-panes -t "$1" -F '#{pane_index}:#{pane_active}:#{pane_width}x#{pane_height}+#{pane_left}+#{pane_top}:#{pane_current_path}'
}
T new-window -d -t alpha:5 -n qshape -c /usr
T split-window -d -h -t alpha:qshape -c /etc
T split-window -d -v -t alpha:qshape.1 -c /var
T resize-pane -t alpha:qshape.0 -x 60
T select-pane -t alpha:qshape.2
T set-option -w -t alpha:qshape automatic-rename off
sleep 0.3
want=$(shape alpha:qshape)
"$BIN" close "$(wid_of alpha:qshape)"
check 'close pushes a snapshot' test "$(wc -l <"$CLOSED")" -eq 1
check '... and the window is gone' bash -c '! tmux -L tmux-home-test list-windows -t alpha -F "#W" | grep -qx qshape'
new=$("$BIN" reopen)
sleep 0.3
eq 'reopen prints the new window ID' "$(wid_of alpha:qshape)" "$new"
eq 'reopen restores index, name, panes, layout, cwds, active pane' "$want" "$(shape "$new")"
check 'reopen pops the stack' test ! -s "$CLOSED"
T kill-window -t "$new"

T new-window -d -t alpha:5 -n qauto
T set-option -w -t alpha:qauto automatic-rename on
"$BIN" close "$(wid_of alpha:5)"
new=$("$BIN" reopen)
eq 'reopen keeps automatic-rename on' on "$(auto_of "$new")"
T kill-window -t "$new"

# old index taken: lands right after its old left-hand neighbour
T new-window -d -t alpha:5 -n qn5
T new-window -d -t alpha:6 -n qn6
T new-window -d -t alpha:7 -n qn7
for n in qn5 qn6 qn7; do T set-option -w -t "alpha:$n" automatic-rename off; done
"$BIN" close "$(wid_of alpha:qn6)"
T move-window -s alpha:qn7 -t alpha:6
new=$("$BIN" reopen)
eq 'reopen with its index taken goes after its old neighbour' 'qn5 qn6 qn7' \
	"$(T list-windows -t alpha -F '#W' | grep '^qn' | tr '\n' ' ' | sed 's/ $//')"
for n in qn5 qn6 qn7; do T kill-window -t "alpha:$n"; done

# a closed session's last window brings the session back
T new-session -d -s qgone -n qlast -c /usr
T set-option -w -t qgone:qlast automatic-rename off
sleep 0.3
"$BIN" close "$(T display -p -t qgone: '#{window_id}')"
check 'closing the last window ends the session' bash -c '! tmux -L tmux-home-test has-session -t "=qgone" 2>/dev/null'
new=$("$BIN" reopen)
sleep 0.3
eq 'reopen recreates the session with the window' 'qgone qlast /usr' \
	"$(T display -p -t "$new" '#{session_name} #{window_name} #{pane_current_path}')"
T kill-session -t '=qgone'

# LIFO, capped at 10
T new-session -d -s qstack
for i in $(seq 1 12); do T new-window -d -t qstack: -n "qs$i"; T set-option -w -t "qstack:qs$i" automatic-rename off; done
for i in $(seq 1 12); do "$BIN" close "$(wid_of "qstack:qs$i")"; done
eq 'stack keeps the last 10 closes' 10 "$(wc -l <"$CLOSED" | tr -d ' ')"
order=''
for i in $(seq 1 10); do order+="$(name_of "$("$BIN" reopen)") "; done
eq 'reopen is LIFO' 'qs12 qs11 qs10 qs9 qs8 qs7 qs6 qs5 qs4 qs3 ' "$order"
nwin=$(T list-windows -a | wc -l)
"$BIN" reopen >/dev/null
eq 'reopen on an empty stack exits 4' 4 "$?"
eq '... and creates nothing' "$nwin" "$(T list-windows -a | wc -l)"
T kill-session -t '=qstack'
: >"$CLOSED"

eq 'layout: >=160 cols -> right' 'change-preview-window(right,50%,border-left,follow)' \
	"$(FZF_COLUMNS=200 FZF_LINES=50 "$BIN" act-layout)"
eq 'layout: <160 cols, >=30 rows -> bottom' 'change-preview-window(down,33%,border-top,follow)' \
	"$(FZF_COLUMNS=150 FZF_LINES=40 "$BIN" act-layout)"
eq 'layout: small -> hidden' 'change-preview-window(down,50%,border-top,follow,hidden)' \
	"$(FZF_COLUMNS=120 FZF_LINES=20 "$BIN" act-layout)"

# ------------------------------------------------------------- binding
echo '# tmux-home.tmux'
T set-option -g @home-keys ''
"$ROOT/tmux-home.tmux"
check "@home-keys '' binds nothing" bash -c '! tmux -L tmux-home-test list-keys -T prefix | grep -E "prefix +w .*tmux-home"'
T set-option -gu @home-keys
"$ROOT/tmux-home.tmux"
check 'default binds prefix w' bash -c 'tmux -L tmux-home-test list-keys -T prefix | grep -Eq "prefix +w +run-shell -b .*display-popup .*TMUX_HOME_CLIENT=#{q:client_name}"'
check 'default binds prefix f' bash -c 'tmux -L tmux-home-test list-keys -T prefix | grep -Eq "prefix +f .*tmux-home"'

# --------------------------------------------------------- interactive
echo '# interactive (client attached inside tmux-home-test-outer)'
O new-session -d -s outer -x 200 -y 50 "env -u TMUX tmux -L tmux-home-test attach -t alpha:editor"
sleep 1
client=$(T list-clients -F '#{client_name}' | head -1)
check 'client attached to test server' test -n "$client"

open_popup() {
	keys C-b w
	wait_for "${1:-popup opens via prefix w}" '^> .*[0-9]+/[0-9]+'
}

open_popup
wait_for 'header shows client location' 'tmux-home +alpha ▸ 0'
s=$(screen)
eq 'list grouped: client session (alpha) first, then beta' 'alpha alpha beta beta' \
	"$(printf '%s\n' "$s" | grep -E '^. (alpha|beta) ' | awk '{ printf "%s%s", (NR > 1 ? " " : ""), $2 }')"
check 'current window marked' grep -Eq 'alpha +▶ +0 +editor' <<<"$s"
check 'preview shown on the right at 200 cols' grep -q '│' <<<"$s"

typed bui
wait_for 'typing filters (1 of 4)' '^> bui .*1/4'
check 'filter kept only beta build' bash -c '[[ $(tmux -L tmux-home-test-outer capture-pane -p -t outer | grep -Ec "^. (alpha|beta) ") == 1 ]]'
esc
wait_for 'Esc clears a non-empty filter' '^> +.*4/4'
check 'popup still open after clearing' popup_open

# navigation: ^n / ^j / ↓ move down, ^p / ^k / ↑ move up (cursor line is
# the one fzf highlights; check via the preview-driving {2} by renaming)
keys C-n
keys C-j
keys Down
keys C-p
keys C-k
keys Up
ok 'navigation keys accepted (^n ^j ↓ ^p ^k ↑)'

# ^r rename: pre-filled, commit, stays open
target=$(wid_of 'alpha:editor')
keys C-r
wait_for '^r opens editor pre-filled with current name' '^rename › editor'
keys C-u
typed 'renamed (x)+y, z'
keys Enter
sleep 0.5
eq '^r ⏎ renames the target window by ID' 'renamed (x)+y, z' "$(name_of "$target")"
wait_for 'fzf still running after rename (list mode prompt)' '^> +.*4/4'
wait_for 'list shows the new name' 'alpha +▶ +0 +renamed \(x\)\+y, z'

# pre-fill with awkward characters round-trips
keys C-r
wait_for '^r pre-fills a name with ( ) + ,' '^rename › renamed \(x\)\+y, z'
esc
wait_for 'Esc in editor returns to list mode' '^> +.*4/4'
eq 'Esc in editor leaves name unchanged' 'renamed (x)+y, z' "$(name_of "$target")"

# empty name cancels
keys C-r
wait_for 'editor reopened' '^rename › '
keys C-u
keys Enter
wait_for 'empty name returns to list mode' '^> +.*4/4'
eq 'empty name leaves name unchanged' 'renamed (x)+y, z' "$(name_of "$target")"

# a filter with fzf-syntax characters survives an editor round-trip
typed '(x)+'
wait_for 'filter with ( ) +' '^> \(x\)\+ .*1/4'
keys C-r
wait_for 'editor opens from that filter' '^rename › renamed'
esc
wait_for 'filter with ( ) + restored after Esc' '^> \(x\)\+ .*1/4'
esc
wait_for 'filter cleared again' '^> +.*4/4'

# filter survives a rename
typed 'win'
wait_for 'filter before rename' '^> win .*1/4'
keys C-r
wait_for 'editor on the filtered window' '^rename › win two'
keys BSpace BSpace BSpace
typed '2'
keys Enter
sleep 0.5
eq 'rename of filtered selection hits the right window' 'win 2' "$(name_of 'alpha:1')"
wait_for 'filter restored after rename' '^> win .*1/4'
esc
wait_for 'filter cleared' '^> +.*4/4'

# M-r resets automatic-rename on the selected window (the current one)
eq 'before M-r: automatic-rename off' off "$(auto_of "$target")"
keys M-r
sleep 0.5
eq 'M-r: automatic-rename back on (by ID)' on "$(auto_of "$target")"
check 'popup still open after M-r' popup_open

# ^o toggles the preview
keys C-o
wait_gone '^o hides the preview' '│'
keys C-o
wait_for '^o shows it again' '│'

# F1 help
keys F1
wait_for 'F1 shows help' 'press any key to return'
keys q
wait_for 'help returns to the list' '^> +.*4/4'

# ------------------------------------------------------------ ^x close
esc
wait_gone 'popup closed before close tests' '^> +.*4/4'
for n in qone qtwo qnext qside; do T new-window -d -t alpha: -n "$n"; done
T new-window -d -t alpha: -n qbusy 'sleep 1000'
T split-window -d -h -t alpha:qside 'sleep 1000'
T set-option -p -t alpha:qside.1 @pane_role sidebar
T send-keys -t alpha:qnext 'echo QNEXT-MARKER' Enter
T new-window -t alpha: -n qcur # not -d: the client's current window
for n in qone qtwo qnext qside qbusy qcur; do T set-option -w -t "alpha:$n" automatic-rename off; done
qcur=$(wid_of alpha:qcur)
wid_exists() { T list-windows -a -F '#{window_id}' | grep -qxF -- "$1"; }
client_at() { T list-clients -F '#{session_name}:#{window_name}' | head -1; }

open_popup 'popup opens on the client current window (qcur)'
wait_for 'header shows qcur' "tmux-home +alpha ▸ $(T display -p -t alpha:qcur '#{window_index}')"
keys C-x
wait_for "^x on the client's current (idle) window closes it at once" '^> +.*9/9'
check '... qcur is gone' bash -c '! tmux -L tmux-home-test list-windows -a -F "#{window_id}" | grep -qxF "$1"' _ "$qcur"
check '... server still up, client still attached' test -n "$(T list-clients -F '#{client_name}')"
check '... client moved to another alpha window' bash -c '[[ $1 == alpha:* && $1 != alpha:qcur ]]' _ "$(client_at)"
wait_for '... header follows the client' "tmux-home +alpha ▸ $(T display -p -t "$(T list-clients -F '#{window_id}' | head -1)" '#{window_index}')"
check '... popup still open' popup_open

typed qone
wait_for 'filter to qone' '^> qone .*1/9'
qone=$(wid_of alpha:qone)
keys C-x
wait_for '^x closes an idle window at once, filter kept' '^> qone .*0/8'
check '... qone is gone' bash -c '! tmux -L tmux-home-test list-windows -a -F "#{window_id}" | grep -qxF "$1"' _ "$qone"
esc
wait_for 'filter cleared after close' '^> +.*8/8'

# cursor: closing row 3 (qtwo) leaves the cursor on the next row (qnext)
keys Down
keys Down
keys C-x
wait_for '^x leaves the cursor on the next row (preview shows qnext)' 'QNEXT-MARKER'
wait_for '... qtwo closed' '^> +.*7/7'
check '... qtwo is gone' bash -c '! tmux -L tmux-home-test list-windows -t alpha -F "#W" | grep -qx qtwo'

# ^x must not act while the rename editor is open
keys C-r
wait_for 'rename editor open on qnext' '^rename › qnext'
keys C-x
sleep 0.5
check '^x ignored during rename: editor still open' bash -c 'tmux -L tmux-home-test-outer capture-pane -p -t outer | grep -q "^rename › qnext"'
check '^x ignored during rename: window kept' wid_exists "$(wid_of alpha:qnext)"
esc
wait_for 'back to the list' '^> +.*7/7'

# busy window: inline confirm; anything but y cancels
typed qbusy
wait_for 'filter to qbusy' '^> qbusy .*1/7'
qbusy=$(wid_of alpha:qbusy)
keys C-x
wait_for '^x on a busy window asks, naming the command' '^close "qbusy"\? running: sleep \(y/N\)'
typed n
wait_for 'n cancels, filter restored' '^> qbusy .*1/7'
check '... window kept after n' wid_exists "$qbusy"
keys C-x
wait_for 'confirm again' '^close "qbusy"\?'
esc
wait_for 'Esc cancels, filter restored' '^> qbusy .*1/7'
check '... window kept after Esc' wid_exists "$qbusy"
keys C-x
wait_for 'confirm again (⏎)' '^close "qbusy"\?'
keys Enter
wait_for '⏎ cancels (default N)' '^> qbusy .*1/7'
check '... window kept after ⏎' wid_exists "$qbusy"
check '... popup still open' popup_open
keys C-x
wait_for 'confirm again (y)' '^close "qbusy"\?'
typed y
wait_for 'y closes it, filter restored' '^> qbusy .*0/6'
check '... qbusy is gone' bash -c '! tmux -L tmux-home-test list-windows -a -F "#{window_id}" | grep -qxF "$1"' _ "$qbusy"
esc

# a sidebar pane running a program doesn't make the window busy
typed qside
wait_for 'filter to qside' '^> qside .*1/6'
keys C-x
wait_for 'window whose only program is a sidebar closes at once' '^> qside .*0/5'
esc
typed qnext
wait_for 'filter to qnext' '^> qnext .*1/5'
keys C-x
wait_for 'qnext closed' '^> qnext .*0/4'
esc
wait_for 'back to the four fixture windows' '^> +.*4/4'

# ^t reopens the last closed window (qnext) and selects it
keys C-t
wait_for '^t reopens the last closed window' '^> +.*5/5'
check '... qnext is back' bash -c 'tmux -L tmux-home-test list-windows -t alpha -F "#W" | grep -qx qnext'
check '... client not switched' bash -c '[[ $1 != *:qnext ]]' _ "$(client_at)"
keys C-r
wait_for '... cursor is on it' '^rename › qnext'
esc
wait_for 'back to list' '^> +.*5/5'
# from a filter that hides it: the filter is cleared, cursor on the window
typed build
wait_for 'filter to build' '^> build .*1/5'
keys C-t
wait_for '^t from a filter clears it and reopens qside' '^> +.*6/6'
keys C-r
wait_for '... cursor is on qside' '^rename › qside'
esc
for n in qnext qside; do
	typed "$n"
	keys C-x
	wait_for "re-close $n" "^> $n .*0/"
	esc
done
wait_for 'back to the four fixture windows again' '^> +.*4/4'
: >"$CLOSED"
keys C-t
wait_for '^t with nothing closed: footer notice' 'nothing to reopen'
check '... no window created' bash -c '[[ $(tmux -L tmux-home-test list-windows -a | wc -l) -eq 4 ]]'
typed x
wait_gone '... notice goes once you type' 'nothing to reopen'
esc
wait_for 'list mode, 4/4' '^> +.*4/4'

# last window of the client's own session: asks (session will end); y moves
# the client to another session first so the popup is not detached
esc
wait_gone 'popup closed' '^> +.*4/4'
T new-session -d -s qdelta -n qd
T switch-client -c "$client" -t qdelta
open_popup 'popup opens in the one-window session qdelta'
wait_for 'header shows qdelta' 'tmux-home +qdelta ▸ 0'
keys C-x
wait_for "^x on the session's last window warns the session will end" '^close "qd"\? — session "qdelta" will end \(y/N\)'
typed y
wait_for 'y closes it; list back to the fixture' '^> +.*4/4'
check '... session qdelta is gone' bash -c '! tmux -L tmux-home-test has-session -t "=qdelta" 2>/dev/null'
check '... server still up, client still attached' test -n "$(T list-clients -F '#{client_name}')"
check '... client moved to another session' bash -c '[[ $1 == alpha:* || $1 == beta:* ]]' _ "$(client_at)"
wait_for '... header follows the client' 'tmux-home +(alpha|beta) ▸ [0-9]'
check '... popup still open' popup_open

# ⏎ switches the invoking client and closes
typed build
wait_for 'filtered to beta build' '^> build .*1/4'
keys Enter
wait_gone 'popup closes on ⏎' '^> build'
eq '⏎ switched the invoking client to beta:build' \
	"$(T display -p -t beta:build '#{session_id} #{window_id}')" \
	"$(T list-clients -F '#{session_id} #{window_id}' | head -1)"

# from beta, beta is listed first
open_popup 'popup reopens'
wait_for 'header follows the client (beta ▸ 1)' 'tmux-home +beta ▸ 1'
eq 'client session (beta) listed first' 'beta beta alpha alpha' \
	"$(screen | grep -E '^. (alpha|beta) ' | awk '{ printf "%s%s", (NR > 1 ? " " : ""), $2 }')"

# Esc on an empty filter closes
esc
wait_gone 'Esc on empty filter closes the popup' '^> +.*4/4'

# layout at 150x40: preview at the bottom
O resize-window -t outer -x 150 -y 40
sleep 0.5
open_popup 'popup opens at 150x40'
check 'no side preview at 150 cols' bash -c '! tmux -L tmux-home-test-outer capture-pane -p -t outer | grep -q "│"'
esc

echo
echo "passed: $pass  failed: $fail"
exit $((fail > 125 ? 125 : fail))
